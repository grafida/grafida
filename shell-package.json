{
    "manifest": "shell.json",
    "phar": {
        "entrypoint": "bin/worker.php",
        "include": [
            {"directory": "bin", "name": "worker.php"},
            {"directory": "src", "name": "*.php"},
            {"directory": "src/Ai/resources"},
            {"directory": "assets/private"},
            {"directory": "assets/public"},
            {"directory": "docs"},
            {"directory": "language"},
            {"directory": "storage/migrations"},
            {"directory": "vendor", "name": "*.php", "notName": ["*Test.php", "*TestCase.php", ".phpstorm.meta.php"]}
        ],
        "ini": {
            "memory_limit": "1G",
            "display_errors": "stderr",
            "opcache.enable": false,
            "opcache.enable_cli": false
        }
    },
    "runtimes": {
        "linux": {
            "shell": {
                "url": "https://github.com/grafida/shell/releases/download/0.4.1/grafida-shell-linux-{arch}",
                "sha256": {
                    "x86_64": "ff063f5a9a265c50b8c807556b579da67cbd502c877724e2f1da7d0c9956b64b",
                    "aarch64": "54f32ce57f2d16589530f6be6164f73f89d07c59127852f41f55ea174248ef92"
                }
            },
            "launcher": {
                "url": "https://github.com/grafida/shell/releases/download/0.4.1/grafida-launcher-linux-{arch}",
                "sha256": {
                    "x86_64": "f6cf57fa0374efd67794da43c67ae03be1b4200fbc84fd20984f85782a0b533d",
                    "aarch64": "5abd94ba624696997160ec22a0d20e00ba9c1532ccf878d5522136c710538dc2"
                }
            },
            "sfx": {
                "url": "https://github.com/grafida/phpmicro/releases/download/sfx-20261109.16/linux-{arch}.standard.sfx",
                "sha256": {
                    "x86_64": "45607f6142ab76333ccb80ebfc08d4412552b9e0cf43ae83c8a278057e17b1e4",
                    "aarch64": "cfefff8e185372c5264454d672df0e02a6e219a47a376a376b7dc62724caa242"
                }
            }
        },
        "macos": {
            "shell": {
                "url": {
                    "aarch64": "https://github.com/grafida/shell/releases/download/0.4.1/grafida-shell-macos-arm64",
                    "x86_64": "https://github.com/grafida/shell/releases/download/0.4.1/grafida-shell-macos-x86_64"
                },
                "sha256": {
                    "aarch64": "ffe124a88da3ad353ca34f763d48a9d685e61012117f3efc0b6cbe97bcbdf578",
                    "x86_64": "25d814fd8204379d78a59bd193ca18f3aadf29707760a78be410f745c1c07aad"
                }
            },
            "sfx": {
                "url": {
                    "aarch64": "https://github.com/grafida/phpmicro/releases/download/sfx-20261109.15/macos-aarch64.standard.sfx",
                    "x86_64": "https://github.com/grafida/phpmicro/releases/download/sfx-20261111.28/macos-x86_64.standard.sfx"
                },
                "sha256": {
                    "aarch64": "046be1292371b1b59498c5df123956c02079e704dd5877d116b8385412134af4",
                    "x86_64": "a89695ce2b64d124d873b3b8f7291820eedf755a1db58d548c6bf3d4f556d8c8"
                }
            }
        },
        "windows": {
            "shell": {
                "url": "https://github.com/grafida/shell/releases/download/0.4.1/grafida-shell-windows-x86_64.exe",
                "sha256": {"x86_64": "e9fe0a5e7ced562e4b0839cf6d29350ca146eaa32e2696ffb1ee1aaca0848c16"}
            },
            "sfx": {
                "url": "https://github.com/grafida/phpmicro/releases/download/sfx-20261110.27/windows-x86_64.standard.sfx",
                "sha256": {"x86_64": "2421951f6a93ba1eb69aabd1592d2df0af030c03b059cff1fefc69f03f764146"}
            }
        }
    },
    "linux": {
        "name": "grafida",
        "desktop": "assets/logo/grafida.desktop",
        "icons": {
            "16": "assets/logo/png/grafida-16.png",
            "24": "assets/logo/png/grafida-24.png",
            "32": "assets/logo/png/grafida-32.png",
            "48": "assets/logo/png/grafida-48.png",
            "64": "assets/logo/png/grafida-64.png",
            "128": "assets/logo/png/grafida-128.png",
            "256": "assets/logo/png/grafida-256.png",
            "512": "assets/logo/png/grafida-512.png"
        },
        "files": {"LICENSE.txt": "LICENSE.txt"},
        "replaces": ["grafida"],
        "output": "build/dist/Grafida-{version}-linux-{debarch}.tar.gz"
    },
    "macos": {
        "name": "Grafida",
        "icon": "assets/logo/Grafida.icns",
        "infoPlist": {
            "NSHumanReadableCopyright": "Copyright (c) 2026 Nicholas K. Dionysopoulos. GNU GPL v3 or later.",
            "LSApplicationCategoryType": "public.app-category.productivity",
            "NSAppTransportSecurity": {"NSAllowsArbitraryLoadsInWebContent": true}
        },
        "entitlements": {"worker": "build/macos/shell-worker.entitlements"},
        "resources": {"LICENSE.txt": "LICENSE.txt"},
        "dmg": {
            "background": "assets/logo/dmg-background.tiff",
            "window": [640, 400],
            "iconSize": 128,
            "textSize": 13,
            "positions": {"app": [160, 210], "applications": [480, 210]},
            "volumeIcon": "assets/logo/Grafida.icns",
            "volumeName": "Grafida"
        },
        "app": "build/shell-macos/{debarch}/{name}.app",
        "output": "build/dist/Grafida-{version}-macos-{debarch}.dmg"
    },
    "windows": {
        "name": "Grafida",
        "icon": "assets/logo/Grafida.ico",
        "version": {
            "companyName": "Akeeba Ltd",
            "legalCopyright": "Copyright (c) 2026 Nicholas K. Dionysopoulos. GNU GPL v3 or later.",
            "workerDescription": "Grafida worker"
        },
        "files": {"LICENSE.txt": "LICENSE.txt"},
        "installer": {
            "script": "build/shell-windows-installer.nsi",
            "defines": {
                "DISPLAYNAME": "Grafida",
                "APPURL": "https://grafida.app",
                "COPYRIGHT": "Copyright (c) 2026 Nicholas K. Dionysopoulos. GNU GPL v3 or later."
            }
        },
        "tree": "build/shell-windows/{name}",
        "output": "build/dist/Grafida-{version}-windows-{debarch}-Setup.exe"
    }
}
