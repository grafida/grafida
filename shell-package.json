{
    "manifest": "shell.json",
    "phar": {
        "entrypoint": "src/worker.php",
        "include": [
            {"directory": "src", "name": "*.php"},
            {"directory": "src/Ai/resources"},
            {"directory": "media/private"},
            {"directory": "media/public"},
            {"directory": "docs"},
            {"directory": "language", "notName": ["*.md"]},
            {"directory": "src/sql"},
            {"directory": "vendor", "name": "*.php", "notName": ["*Test.php", "*TestCase.php", ".phpstorm.meta.php"]}
        ],
        "ini": {
            "memory_limit": "1G",
            "display_errors": "stderr",
            "opcache.enable": false,
            "opcache.enable_cli": false
        }
    },
    "shell": {
        "version": "^0.4.1"
    },
    "runtimes": {
        "linux": {
            "sfx": {
                "url": "https://github.com/grafida/phpmicro/releases/download/sfx-20261109.16/linux-{arch}.standard.sfx",
                "sha256": {
                    "x86_64": "45607f6142ab76333ccb80ebfc08d4412552b9e0cf43ae83c8a278057e17b1e4",
                    "aarch64": "cfefff8e185372c5264454d672df0e02a6e219a47a376a376b7dc62724caa242"
                }
            },
            "appimage-runtime": {
                "url": "https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-{arch}",
                "sha256": {
                    "x86_64": "2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d",
                    "aarch64": "00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444"
                }
            }
        },
        "macos": {
            "sfx": {
                "url": {
                    "aarch64": "https://github.com/grafida/phpmicro/releases/download/sfx-20261109.15/macos-aarch64.standard.sfx",
                    "x86_64": "https://github.com/grafida/phpmicro/releases/download/sfx-20261111.28/macos-x86_64.standard.sfx"
                },
                "sha256": {
                    "aarch64": "046be1292371b1b59498c5df123956c02079e704dd5877d116b8385412134af4",
                    "x86_64": "a89695ce2b64d124d873b3b8f7291820eedf755a1db58d548c6bf3d4f556d8c8"
                }
            }
        },
        "windows": {
            "sfx": {
                "url": "https://github.com/grafida/phpmicro/releases/download/sfx-20261110.27/windows-x86_64.standard.sfx",
                "sha256": {"x86_64": "2421951f6a93ba1eb69aabd1592d2df0af030c03b059cff1fefc69f03f764146"}
            }
        }
    },
    "linux": {
        "name": "grafida",
        "desktop": "build/logo/grafida.desktop",
        "icons": {
            "16": "build/logo/png/grafida-16.png",
            "24": "build/logo/png/grafida-24.png",
            "32": "build/logo/png/grafida-32.png",
            "48": "build/logo/png/grafida-48.png",
            "64": "build/logo/png/grafida-64.png",
            "128": "build/logo/png/grafida-128.png",
            "256": "build/logo/png/grafida-256.png",
            "512": "build/logo/png/grafida-512.png"
        },
        "files": {"LICENSE.txt": "LICENSE.txt"},
        "replaces": ["grafida"],
        "package": {
            "maintainer": "Nicholas K. Dionysopoulos <nicholas@akeeba.com>",
            "license": "GPL-3.0-or-later",
            "homepage": "https://grafida.app",
            "description": "Create and edit Joomla! articles offline, then publish them through the Joomla Web Services API.",
            "section": "web",
            "output": {
                "deb": "release/Grafida-{version}-linux-{debarch}.deb",
                "rpm": "release/Grafida-{version}-linux-{arch}.rpm"
            }
        },
        "appimage": {
            "updateInformation": "gh-releases-zsync|grafida|grafida|latest|Grafida-*-linux-{debarch}.AppImage.zsync",
            "output": "release/Grafida-{version}-linux-{arch}.AppImage"
        },
        "pkgbuild": {
            "source": "https://github.com/grafida/grafida/releases/download/{version}/Grafida-{version}-linux-{debarch}.tar.gz",
            "description": "Create and edit Joomla! articles offline, then publish them through the Joomla Web Services API.",
            "url": "https://grafida.app",
            "license": ["GPL-3.0-or-later"],
            "maintainer": "Nicholas K. Dionysopoulos <nicholas@akeeba.com>",
            "output": "release/PKGBUILD"
        },
        "output": "release/Grafida-{version}-linux-{debarch}.tar.gz"
    },
    "macos": {
        "name": "Grafida",
        "icon": "build/logo/Grafida.icns",
        "infoPlist": {
            "NSHumanReadableCopyright": "Copyright (c) 2026 Nicholas K. Dionysopoulos. GNU GPL v3 or later.",
            "LSApplicationCategoryType": "public.app-category.productivity",
            "NSAppTransportSecurity": {"NSAllowsArbitraryLoadsInWebContent": true}
        },
        "entitlements": {"worker": "build/macos/shell-worker.entitlements"},
        "resources": {"LICENSE.txt": "LICENSE.txt"},
        "dmg": {
            "background": "build/logo/dmg-background.tiff",
            "window": [640, 400],
            "iconSize": 128,
            "textSize": 13,
            "positions": {"app": [160, 210], "applications": [480, 210]},
            "volumeIcon": "build/logo/Grafida.icns",
            "volumeName": "Grafida"
        },
        "app": "tmp/shell-macos/{debarch}/{name}.app",
        "output": "release/Grafida-{version}-macos-{debarch}.dmg"
    },
    "windows": {
        "name": "Grafida",
        "icon": "build/logo/Grafida.ico",
        "version": {
            "companyName": "Akeeba Ltd",
            "legalCopyright": "Copyright (c) 2026 Nicholas K. Dionysopoulos. GNU GPL v3 or later.",
            "workerDescription": "Grafida worker"
        },
        "files": {"LICENSE.txt": "LICENSE.txt"},
        "installer": {
            "script": "build/windows/shell-windows-installer.nsi",
            "defines": {
                "DISPLAYNAME": "Grafida",
                "APPURL": "https://grafida.app",
                "COPYRIGHT": "Copyright (c) 2026 Nicholas K. Dionysopoulos. GNU GPL v3 or later."
            }
        },
        "tree": "tmp/shell-windows/{name}",
        "output": "release/Grafida-{version}-windows-{debarch}-Setup.exe"
    }
}
