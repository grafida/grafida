<project name="Grafida" description="Grafida — desktop Joomla! article editor" default="package" basedir=".">

	<property name="dirs.root" value="${phing.dir}" />
	<property name="dirs.icon" value="${dirs.root}/assets/logo" />
	<property name="dirs.dist" value="${dirs.root}/build/dist" />
	<property name="setversion.script" value="${dirs.root}/build/tasks/set-version.php" />
	<property name="assets.marker" value="${dirs.root}/assets/private/js/tinymce/tinymce.min.js" />

	<!--
	Private build configuration (secrets): GitHub Releases + CDN FTP credentials for publishing
	releases and update information. This file is gitignored and never committed — copy
	build/build.sample.properties to build/build.properties and fill it in. A missing file is
	tolerated (Phing skips it), so targets that don't need these properties keep working.
	-->
	<property file="${dirs.root}/build/build.properties" override="true" />

	<!--
	macOS code-signing / notarisation defaults. These do NOT override values set in build.properties
	(above); they merely default to empty so the package-macos-* targets can forward them to the build
	scripts without leaving an unexpanded ${...} literal when build.properties omits them. Set
	macos.sign.identity + macos.notary.profile in build.properties to sign+notarise — see
	build/readme/01-macos-signing.md.
	-->
	<property name="macos.sign.identity" value="" />
	<property name="macos.notary.profile" value="" />

	<!--
	Windows code-signing defaults (Azure Artifact Signing + Jsign — see
	build/readme/04-exe-signing-on-macos.md). windows.sign.op-item empty (the default) leaves the
	installer and everything in it unsigned, exactly like the macOS defaults above. Only set these in
	build.properties: Azure's Basic tier is capped at 5,000 signatures a month, and a signed Windows
	build costs four (the shell, the worker stub, the uninstaller, the installer).
	-->
	<property name="windows.sign.op-item" value="" />
	<property name="windows.sign.op-field-appid" value="appId" />
	<property name="windows.sign.op-field-password" value="password" />
	<property name="windows.sign.op-field-tenant" value="tenant" />
	<property name="windows.sign.keystore" value="weu.codesigning.azure.net" />
	<property name="windows.sign.alias" value="akeeba-signing/AkeebaPublic" />
	<property name="windows.sign.tsaurl" value="http://timestamp.acs.microsoft.com" />

	<!--
	Custom Phing tasks live in build/tasks/ under the `tasks\` namespace; the classpath points at build/
	so `tasks\Foo` resolves to build/tasks/Foo.php.
	-->
	<taskdef name="githubrelease" classname="tasks\GitHubRelease" classpath="${dirs.root}/build" />
	<taskdef name="updatejson"    classname="tasks\UpdateJson"    classpath="${dirs.root}/build" />
	<taskdef name="ftpsupload"    classname="tasks\FtpsUpload"    classpath="${dirs.root}/build" />

	<!--
	====================================================================================================
	Tasks - General
	====================================================================================================
	-->

	<!--
	Everything that must be on disk before a package is built. The worker PHAR that shell-packager
	builds carries assets/private, and the packages carry the icons, so the Composer dependencies
	(grafida/shell-packager among them), the npm-managed front-end libraries and the per-platform icons
	all have to exist first. Phing runs each target at most once per invocation, so the five package
	targets share a single preparation pass. Every sub-target is guarded — skipped when its output is
	already in place (pass -Drefresh.assets=1 to force a re-vendor). prepare-composer is the
	exception: it always runs, see below.
	-->
	<target name="prepare" depends="prepare-composer,prepare-icons,prepare-assets,set-version"
			description="Ensure dependencies, icons + front-end libraries are on disk before packaging" />

	<!--
	Stamp the application version (App::VERSION) from the topmost CHANGELOG entry before every package,
	so the PHAR and the About dialog report the right version. Runs unguarded (it is a cheap, idempotent
	regex replace that no-ops when the version already matches). GRAFIDA_VERSION overrides the CHANGELOG.
	-->
	<target name="set-version" description="Stamp App::VERSION from the CHANGELOG">
		<exec executable="php" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="${setversion.script}" />
		</exec>
	</target>

	<!--
	Composer runs on every invocation, not only when vendor/ is missing: `composer install` brings
	vendor/ in line with composer.lock, so a pull or a different machine never builds against stale
	dependencies (a stale grafida/shell-packager once failed with "Unknown command"). Nothing to do
	costs under a second. `no-scripts`, because post-install-cmd is `vendor:assets` (npm, ~5 s), which
	prepare-assets runs when its marker is missing, so a fresh clone still vendors the front-end
	libraries.
	-->
	<target name="prepare-composer"
			description="Bring the Composer dependencies in line with composer.lock">
		<exec executable="composer" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="install" />
			<arg value="--no-scripts" />
			<arg value="--no-interaction" />
		</exec>
	</target>

	<!--
	The per-platform icons (Grafida.icns / Grafida.ico / the PNG set) are committed, so this normally
	no-ops; it only re-rasterises them from assets/logo/grafida.svg if they have gone missing.
	-->
	<condition property="icons.present">
		<and>
			<available file="${dirs.icon}/Grafida.icns" type="file" />
			<available file="${dirs.icon}/Grafida.ico" type="file" />
		</and>
	</condition>

	<target name="prepare-icons" unless="icons.present"
			description="Rasterise the application icons from the master SVG (only if missing)">
		<echo>Application icons missing — regenerating from assets/logo/grafida.svg</echo>
		<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="scripts/make-icons.sh" />
		</exec>
	</target>

	<!--
	The front-end libraries (TinyMCE, CodeMirror, FontAwesome) are npm-managed and gitignored, yet the
	worker PHAR carries assets/private — so they must be vendored first. `vendor:assets`
	is idempotent (an mtime guard skips files already copied). We skip the whole step when the marker
	file is already present, unless -Drefresh.assets=1 forces a re-vendor.
	-->
	<condition property="skip.assets">
		<and>
			<available file="${assets.marker}" type="file" />
			<not><isset property="refresh.assets" /></not>
		</and>
	</condition>

	<target name="prepare-assets" unless="skip.assets"
			description="Vendor the npm-managed front-end libraries (TinyMCE, CodeMirror, FontAwesome)">
		<echo>Vendoring front-end libraries (composer run-script vendor:assets)</echo>
		<exec executable="composer" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="run-script" />
			<arg value="vendor:assets" />
		</exec>
	</target>

	<!--
	====================================================================================================
	Tasks - Tests

	Runs the full PHPUnit suite (unit + feature + integration, per composer.json's `test` script).
	Only needs the Composer dependencies — not the icons or npm-vendored front-end assets — so it
	depends on prepare-composer directly rather than the full `prepare`.
	====================================================================================================
	-->

	<target name="tests" depends="prepare-composer" description="Run the full PHPUnit test suite">
		<exec executable="composer" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="test" />
		</exec>
	</target>

	<!--
	====================================================================================================
	Tasks - Run

	`run` starts Grafida in the native shell's dev mode on this host: the sibling ../shell clone, built
	with the automation channel, with the system `php bin/worker.php` as the worker, so a PHP edit
	takes effect when the worker restarts and nothing is compiled or packaged (`composer shell:dev`).
	====================================================================================================
	-->

	<target name="run" depends="prepare-composer,prepare-assets"
			description="Run Grafida in the native shell's dev mode (needs the ../shell clone)">
		<exec executable="composer" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="shell:dev" />
		</exec>
	</target>

	<!--
	====================================================================================================
	Tasks - Packages (gh-92)

	Each package-* target builds one distributable into build/dist/ with grafida/shell-packager, from
	shell-package.json (pins, names, outputs) and shell.json (the app manifest), through the
	scripts/make-*.sh helpers that scripts/build-all.sh (`composer build`) also uses. All five are
	built on the Mac: the macOS bundles need codesign, notarytool and hdiutil; the Windows installer
	needs makensis, Jsign and osslsigncode, which run there too; the Linux tarballs need nothing
	native. Each artefact gets a .sha256 beside it.

	Signing credentials are forwarded as POSITIONAL ARGS, not <env> entries, then re-exported inside a
	one-line bash prologue. Phing 3's ExecTask (in passthru mode) forwards <env> by building an
	UNESCAPED `export KEY=VALUE; …; cmd` shell string, which breaks on any value containing shell
	metacharacters — e.g. a Developer ID identity "Developer ID Application: … (TEAMID)" or a 1Password
	item name like "Microsoft Account (previously: Hotmail)" (the parentheses trigger a shell syntax
	error). Args are passed through as argv and properly escaped, so `export VAR="$1"` reconstructs the
	exact value regardless of its contents. $0 is a throwaway label; the real values start at $1.
	====================================================================================================
	-->

	<target name="package"
			description="Package every platform: the macOS DMGs, the Linux tarballs and the Windows installer"
			depends="package-macos-arm,package-macos-x86,package-windows-x86,package-linux-x86,package-linux-arm">
		<echo>Packaged all Grafida platforms into build/dist/.</echo>
	</target>

	<!--
	The macOS disk images, one per architecture (arm64; x86_64 for Intel Macs, gh-92). Signed and
	notarised with macos.sign.identity and macos.notary.profile from build.properties when they are
	set, ad hoc otherwise.
	-->
	<target name="package-macos-arm" depends="prepare" description="Package the macOS (Apple Silicon) .dmg">
		<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="-c" />
			<arg value="export MACOS_SIGN_IDENTITY=&quot;$1&quot;; export MACOS_NOTARY_PROFILE=&quot;$2&quot;; exec bash scripts/make-macos-dmg.sh arm64" />
			<arg value="phing" />
			<arg value="${macos.sign.identity}" />
			<arg value="${macos.notary.profile}" />
		</exec>
	</target>

	<target name="package-macos-x86" depends="prepare" description="Package the macOS (Intel) .dmg">
		<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="-c" />
			<arg value="export MACOS_SIGN_IDENTITY=&quot;$1&quot;; export MACOS_NOTARY_PROFILE=&quot;$2&quot;; exec bash scripts/make-macos-dmg.sh amd64" />
			<arg value="phing" />
			<arg value="${macos.sign.identity}" />
			<arg value="${macos.notary.profile}" />
		</exec>
	</target>

	<!--
	The Windows (x64) installer, signed with Azure Trusted Signing through the windows.sign.*
	properties. windows.sign.op-item is the one switch: empty, no signing step at all (the script is
	called with no signing settings); set, a signed build with the rest of the windows.sign.*
	properties.
	-->
	<target name="package-windows-x86" depends="prepare" description="Package the Windows (x64) installer">
		<if>
			<equals arg1="${windows.sign.op-item}" arg2="" />
			<then>
				<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
					<arg value="scripts/make-windows-installer.sh" />
				</exec>
			</then>
			<else>
				<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
					<arg value="-c" />
					<arg value="export WINDOWS_SIGN_OP_ITEM=&quot;$1&quot;; export WINDOWS_SIGN_OP_FIELD_APPID=&quot;$2&quot;; export WINDOWS_SIGN_OP_FIELD_PASSWORD=&quot;$3&quot;; export WINDOWS_SIGN_OP_FIELD_TENANT=&quot;$4&quot;; export WINDOWS_SIGN_KEYSTORE=&quot;$5&quot;; export WINDOWS_SIGN_ALIAS=&quot;$6&quot;; export WINDOWS_SIGN_TSAURL=&quot;$7&quot;; exec bash scripts/make-windows-installer.sh" />
					<arg value="phing" />
					<arg value="${windows.sign.op-item}" />
					<arg value="${windows.sign.op-field-appid}" />
					<arg value="${windows.sign.op-field-password}" />
					<arg value="${windows.sign.op-field-tenant}" />
					<arg value="${windows.sign.keystore}" />
					<arg value="${windows.sign.alias}" />
					<arg value="${windows.sign.tsaurl}" />
				</exec>
			</else>
		</if>
	</target>

	<target name="package-linux-x86" depends="prepare" description="Package the Linux (x64) .tar.gz">
		<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="scripts/make-linux-tarball.sh" />
			<arg value="amd64" />
		</exec>
	</target>

	<target name="package-linux-arm" depends="prepare" description="Package the Linux (ARM64) .tar.gz">
		<exec executable="bash" dir="${dirs.root}" passthru="true" checkreturn="true">
			<arg value="scripts/make-linux-tarball.sh" />
			<arg value="arm64" />
		</exec>
	</target>

	<!--
	====================================================================================================
	Tasks - Release

	`all` is an alias for `package` (package every platform). `release` is the standard release
	process: package everything, create a published GitHub release with the five artefacts and their
	.sha256 files as assets and RELEASENOTES.md as the description, build a grafida.json from that
	release (UpdateJson, which writes the `requires` table, gh-92) and upload it to the CDN over FTPS.
	Needs the github.* and cdn.ftp.* properties from build/build.properties.
	====================================================================================================
	-->

	<target name="all" depends="package"
			description="Alias for 'package' — package every platform" />

	<!--
	Publishing docs/ to the Grafida.app Documentation section is scripts/upload-docs.sh
	(`composer docs:publish`), and it is deliberately NOT a Phing target and NOT a release step: the
	app serves Help out of its own bundle, so the site and the shipped build are independent and a
	typo fix should not wait for a version bump. See build/readme/05-documentation-publishing.md.
	-->

	<target name="release" depends="all"
			description="Build, publish a GitHub release with the artifacts, and push grafida.json to the CDN">
		<!-- The version is the topmost CHANGELOG entry (the same source set-version stamps into the app). -->
		<exec executable="php" dir="${dirs.root}" outputProperty="version" checkreturn="true">
			<arg value="${setversion.script}" />
			<arg value="--print" />
		</exec>

		<fail unless="github.token" message="release: github.token is not set — copy build/build.sample.properties to build/build.properties and fill it in." />
		<fail unless="cdn.ftp.password" message="release: cdn.ftp.* is not set — copy build/build.sample.properties to build/build.properties and fill it in." />

		<echo>Releasing Grafida ${version} to ${github.organization}/${github.repository}</echo>

		<!-- 1. Create a published GitHub release with the distributables as assets. -->
		<githubrelease token="${github.token}"
					   organization="${github.organization}"
					   repository="${github.repository}"
					   tagName="${version}"
					   releaseName="Grafida ${version}"
					   bodyFile="${dirs.root}/RELEASENOTES.md"
					   draft="false">
			<fileset dir="${dirs.dist}">
				<include name="Grafida-${version}-macos-arm64.dmg" />
				<include name="Grafida-${version}-macos-arm64.dmg.sha256" />
				<include name="Grafida-${version}-macos-amd64.dmg" />
				<include name="Grafida-${version}-macos-amd64.dmg.sha256" />
				<include name="Grafida-${version}-linux-amd64.tar.gz" />
				<include name="Grafida-${version}-linux-amd64.tar.gz.sha256" />
				<include name="Grafida-${version}-linux-arm64.tar.gz" />
				<include name="Grafida-${version}-linux-arm64.tar.gz.sha256" />
				<include name="Grafida-${version}-windows-amd64-Setup.exe" />
				<include name="Grafida-${version}-windows-amd64-Setup.exe.sha256" />
			</fileset>
		</githubrelease>

		<!-- 2. Build grafida.json from the just-published release. -->
		<updatejson organization="${github.organization}"
					repository="${github.repository}"
					token="${github.token}"
					outfile="${dirs.dist}/grafida.json" />

		<!-- 3. Upload grafida.json to the CDN over FTPS. -->
		<ftpsupload host="${cdn.ftp.hostname}"
					username="${cdn.ftp.username}"
					password="${cdn.ftp.password}"
					remoteDir="${cdn.ftp.directory}">
			<fileset dir="${dirs.dist}">
				<include name="grafida.json" />
			</fileset>
		</ftpsupload>

		<echo>Release ${version} complete.</echo>
	</target>
</project>
